{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimum Playable Campaign Manifest",
  "type": "object",
  "required": ["campaign_history", "starting_situation", "character_profile_references"],
  "properties": {
    "campaign_history": {"type": "string", "minLength": 1},
    "starting_situation": {"type": "string", "minLength": 1},
    "character_profile_references": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "optional_material_references": {"type": "array"}
  }
}
