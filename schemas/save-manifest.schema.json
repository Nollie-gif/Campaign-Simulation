{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Save Manifest",
  "type": "object",
  "required": ["id", "kind", "status", "created_at", "record_revisions"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["quick", "final"]},
    "status": {"enum": ["prepared", "validated", "committed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "record_revisions": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
